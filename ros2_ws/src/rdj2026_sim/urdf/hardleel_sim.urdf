<?xml version="1.0"?>
<!--
  Simulated "hardleel" for Gazebo (Ignition) Fortress + ROS 2 Humble.
  Frames and topics match the real robot so the same SLAM / Nav2 config works:
    base_link -> laser     z 0.15, yaw 0   (RPLIDAR A1, /scan, ~5.5 Hz, 0.15-12 m)
    base_link -> imu_link  z 0.05          (/imu/data_raw, 100 Hz)
    /cmd_vel in, /odom + odom->base_link TF out (diff drive)
  Body sized inside the 30 x 30 x 30 cm rule. Chassis/wheel sizes are estimates.
-->
<robot name="hardleel">

  <link name="base_link">
    <visual>
      <origin xyz="0 0 0.03"/>
      <geometry><box size="0.26 0.22 0.08"/></geometry>
      <material name="body"><color rgba="0.15 0.35 0.75 1"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0.03"/>
      <geometry><box size="0.26 0.22 0.08"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.02"/>
      <mass value="1.8"/>
      <inertia ixx="0.009" ixy="0" ixz="0" iyy="0.012" iyz="0" izz="0.018"/>
    </inertial>
  </link>

  <!-- four driven wheels (skid steer): left pair / right pair share one command each. Wheelbase 0.20, track 0.245 -->
  <link name="front_left_wheel">
    <visual><origin rpy="1.5708 0 0"/><geometry><cylinder radius="0.035" length="0.025"/></geometry>
      <material name="tyre"><color rgba="0.1 0.1 0.1 1"/></material></visual>
    <collision><origin rpy="1.5708 0 0"/><geometry><cylinder radius="0.035" length="0.025"/></geometry></collision>
    <inertial><mass value="0.08"/><inertia ixx="3e-5" ixy="0" ixz="0" iyy="5e-5" iyz="0" izz="3e-5"/></inertial>
  </link>
  <joint name="front_left_wheel_joint" type="continuous">
    <parent link="base_link"/><child link="front_left_wheel"/>
    <origin xyz="0.10 0.1225 0"/><axis xyz="0 1 0"/>
  </joint>

  <link name="rear_left_wheel">
    <visual><origin rpy="1.5708 0 0"/><geometry><cylinder radius="0.035" length="0.025"/></geometry>
      <material name="tyre"><color rgba="0.1 0.1 0.1 1"/></material></visual>
    <collision><origin rpy="1.5708 0 0"/><geometry><cylinder radius="0.035" length="0.025"/></geometry></collision>
    <inertial><mass value="0.08"/><inertia ixx="3e-5" ixy="0" ixz="0" iyy="5e-5" iyz="0" izz="3e-5"/></inertial>
  </link>
  <joint name="rear_left_wheel_joint" type="continuous">
    <parent link="base_link"/><child link="rear_left_wheel"/>
    <origin xyz="-0.10 0.1225 0"/><axis xyz="0 1 0"/>
  </joint>

  <link name="front_right_wheel">
    <visual><origin rpy="1.5708 0 0"/><geometry><cylinder radius="0.035" length="0.025"/></geometry>
      <material name="tyre"><color rgba="0.1 0.1 0.1 1"/></material></visual>
    <collision><origin rpy="1.5708 0 0"/><geometry><cylinder radius="0.035" length="0.025"/></geometry></collision>
    <inertial><mass value="0.08"/><inertia ixx="3e-5" ixy="0" ixz="0" iyy="5e-5" iyz="0" izz="3e-5"/></inertial>
  </link>
  <joint name="front_right_wheel_joint" type="continuous">
    <parent link="base_link"/><child link="front_right_wheel"/>
    <origin xyz="0.10 -0.1225 0"/><axis xyz="0 1 0"/>
  </joint>

  <link name="rear_right_wheel">
    <visual><origin rpy="1.5708 0 0"/><geometry><cylinder radius="0.035" length="0.025"/></geometry>
      <material name="tyre"><color rgba="0.1 0.1 0.1 1"/></material></visual>
    <collision><origin rpy="1.5708 0 0"/><geometry><cylinder radius="0.035" length="0.025"/></geometry></collision>
    <inertial><mass value="0.08"/><inertia ixx="3e-5" ixy="0" ixz="0" iyy="5e-5" iyz="0" izz="3e-5"/></inertial>
  </link>
  <joint name="rear_right_wheel_joint" type="continuous">
    <parent link="base_link"/><child link="rear_right_wheel"/>
    <origin xyz="-0.10 -0.1225 0"/><axis xyz="0 1 0"/>
  </joint>

  <!-- RPLIDAR A1 -->
  <link name="laser">
    <visual><geometry><cylinder radius="0.035" length="0.04"/></geometry>
      <material name="lidar"><color rgba="0.05 0.05 0.05 1"/></material></visual>
    <collision><geometry><cylinder radius="0.035" length="0.04"/></geometry></collision>
    <inertial><mass value="0.17"/><inertia ixx="5e-5" ixy="0" ixz="0" iyy="5e-5" iyz="0" izz="8e-5"/></inertial>
  </link>
  <joint name="laser_joint" type="fixed">
    <parent link="base_link"/><child link="laser"/><origin xyz="0 0 0.15" rpy="0 0 0"/>
  </joint>

  <link name="imu_link">
    <inertial><mass value="0.005"/><inertia ixx="1e-7" ixy="0" ixz="0" iyy="1e-7" iyz="0" izz="1e-7"/></inertial>
  </link>
  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/><child link="imu_link"/><origin xyz="0 0 0.05"/>
  </joint>

  <!-- Pi Camera Module 3, forward, same mount as robot_slam.stack_common (CAM_X/Y/Z, nominal) -->
  <link name="camera">
    <visual><geometry><box size="0.02 0.05 0.03"/></geometry><material name="lidar"/></visual>
    <inertial><mass value="0.01"/><inertia ixx="1e-7" ixy="0" ixz="0" iyy="1e-7" iyz="0" izz="1e-7"/></inertial>
  </link>
  <joint name="camera_joint" type="fixed">
    <parent link="base_link"/><child link="camera"/><origin xyz="0.10 0 0.20" rpy="0 0 0"/>
  </joint>

  <!-- skid steer: grip along the roll direction, less sideways so the robot can turn in place (PLACEHOLDER values) -->
  <gazebo reference="front_left_wheel"><mu1>1.2</mu1><mu2>0.7</mu2><fdir1>1 0 0</fdir1></gazebo>
  <gazebo reference="rear_left_wheel"><mu1>1.2</mu1><mu2>0.7</mu2><fdir1>1 0 0</fdir1></gazebo>
  <gazebo reference="front_right_wheel"><mu1>1.2</mu1><mu2>0.7</mu2><fdir1>1 0 0</fdir1></gazebo>
  <gazebo reference="rear_right_wheel"><mu1>1.2</mu1><mu2>0.7</mu2><fdir1>1 0 0</fdir1></gazebo>

  <gazebo reference="laser">
    <sensor name="lidar" type="gpu_lidar">
      <topic>scan</topic>
      <ignition_frame_id>laser</ignition_frame_id>
      <update_rate>6.4</update_rate>
      <always_on>1</always_on>
      <visualize>true</visualize>
      <ray>
        <scan><horizontal><samples>360</samples><resolution>1</resolution>
          <min_angle>-3.14159</min_angle><max_angle>3.14159</max_angle></horizontal></scan>
        <range><min>0.15</min><max>12.0</max><resolution>0.01</resolution></range>
        <noise><type>gaussian</type><mean>0.0</mean><stddev>0.01</stddev></noise>
      </ray>
    </sensor>
  </gazebo>

  <gazebo reference="camera">
    <sensor name="camera" type="camera">
      <topic>camera/image_raw</topic>
      <ignition_frame_id>camera</ignition_frame_id>
      <update_rate>10</update_rate>            <!-- real: 30 fps; 10 keeps the sim real-time (PLACEHOLDER) -->
      <always_on>1</always_on>
      <camera>
        <horizontal_fov>1.152</horizontal_fov>  <!-- Pi Camera Module 3 standard lens, 66 deg (placeholder: check wide/standard) -->
        <image><width>640</width><height>480</height><format>R8G8B8</format></image>
        <clip><near>0.05</near><far>10</far></clip>
      </camera>
    </sensor>
  </gazebo>

  <!-- IMU: the real Arduino Nano 33 BLE gyro has a raw bias of about -12.4 deg/s which imu_serial_node calibrates away at
       start; what the stack sees is the RESIDUAL (~1.3 deg/min = 3.8e-4 rad/s) plus noise. All values are PLACEHOLDERS. -->
  <gazebo reference="imu_link">
    <sensor name="imu" type="imu">
      <topic>imu/data_raw</topic>
      <ignition_frame_id>imu_link</ignition_frame_id>
      <update_rate>93</update_rate>
      <always_on>1</always_on>
      <imu>
        <angular_velocity>
          <x><noise type="gaussian"><mean>0</mean><stddev>0.002</stddev></noise></x>
          <y><noise type="gaussian"><mean>0</mean><stddev>0.002</stddev></noise></y>
          <z><noise type="gaussian"><mean>0</mean><stddev>0.002</stddev><bias_mean>0.00038</bias_mean><bias_stddev>0.0001</bias_stddev></noise></z>
        </angular_velocity>
        <linear_acceleration>
          <x><noise type="gaussian"><mean>0</mean><stddev>0.02</stddev></noise></x>
          <y><noise type="gaussian"><mean>0</mean><stddev>0.02</stddev></noise></y>
          <z><noise type="gaussian"><mean>0</mean><stddev>0.02</stddev></noise></z>
        </linear_acceleration>
      </imu>
    </sensor>
  </gazebo>

  <gazebo>
    <plugin filename="ignition-gazebo-diff-drive-system" name="ignition::gazebo::systems::DiffDrive">
      <left_joint>front_left_wheel_joint</left_joint>
      <left_joint>rear_left_wheel_joint</left_joint>
      <right_joint>front_right_wheel_joint</right_joint>
      <right_joint>rear_right_wheel_joint</right_joint>
      <wheel_separation>0.245</wheel_separation>
      <wheel_radius>0.035</wheel_radius>
      <max_linear_acceleration>1.0</max_linear_acceleration>
      <topic>cmd_vel</topic>
      <odom_topic>odom</odom_topic>
      <tf_topic>tf</tf_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_link</child_frame_id>
      <odom_publish_frequency>30</odom_publish_frequency>
    </plugin>
    <plugin filename="ignition-gazebo-joint-state-publisher-system" name="ignition::gazebo::systems::JointStatePublisher">
      <topic>joint_states</topic>
    </plugin>
    <!-- ground-truth pose in the world frame (/ground_truth), for testing localization accuracy -->
    <plugin filename="ignition-gazebo-odometry-publisher-system" name="ignition::gazebo::systems::OdometryPublisher">
      <odom_frame>world</odom_frame>
      <robot_base_frame>base_link</robot_base_frame>
      <odom_topic>ground_truth</odom_topic>
      <tf_topic>ground_truth_tf</tf_topic>
      <odom_publish_frequency>20</odom_publish_frequency>
      <dimensions>2</dimensions>
    </plugin>
  </gazebo>
</robot>
